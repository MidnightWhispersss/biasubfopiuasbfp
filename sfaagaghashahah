local function formatNumber(number)
    local str = tostring(number)
    repeat
        local replaced, count = str:gsub((_S[1381]), (_S[1382]))
        str = replaced
    until count == 0
    return str
end

local function getFruitStock()
    local resultStr = (_S[1383])
    local success, advanceFruits = pcall(function()
        return game:GetService((_S[1])).Remotes.CommF_:InvokeServer((_S[798]), true)
    end)

    if not success or not advanceFruits then
        resultStr = resultStr .. (_S[1384])
    else
        local hasFruit = false
        for _, fruit in pairs(advanceFruits) do
            if fruit.OnSale then
                hasFruit = true
                resultStr = resultStr .. fruit.Name .. (_S[1385]) .. formatNumber(fruit.Price) .. (_S[1386])
            end
        end
        if not hasFruit then
            resultStr = resultStr .. (_S[1387])
        end
    end

    resultStr = resultStr .. (_S[1388])
    local success2, normalFruits = pcall(function()
        return game:GetService((_S[1])).Remotes.CommF_:InvokeServer((_S[798]))
    end)

    if success2 and normalFruits then
        local hasFruit = false
        for _, fruit in pairs(normalFruits) do
            if fruit.OnSale then
                hasFruit = true
                resultStr = resultStr .. fruit.Name .. (_S[1385]) .. formatNumber(fruit.Price) .. (_S[1386])
            end
        end
        if not hasFruit then
            resultStr = resultStr .. (_S[1387])
        end
    else
        resultStr = resultStr .. (_S[1384])
    end

    return resultStr
end

