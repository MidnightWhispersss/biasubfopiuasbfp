features.Visuals.GetInfo = function(line, object, descendant)
	local callbackFunction = line:GetAttribute((_S[383])) or line:GetAttribute((_S[913])) or line:GetAttribute((_S[366])) or line:GetAttribute((_S[914])) or object:GetAttribute((_S[383])) or object:GetAttribute((_S[913])) or object:GetAttribute((_S[366])) or object:GetAttribute((_S[914]))

	if not callbackFunction then
		local rootPart = object:FindFirstChild((_S[384]))

		if rootPart then
			for _, particle in rootPart:GetChildren() do
				if particle:IsA((_S[915])) and particle.Enabled then
					callbackFunction = particle.Name
					break
				end
			end
		end
	end

	if not callbackFunction then
		return nil
	end
	local difference = 0
	local coins = line:FindFirstChild((_S[510]))
	coins = coins and coins:FindFirstChild(callbackFunction)

	if coins and coins:IsA((_S[767])) then
		difference = tonumber(coins.Value) or 0
	end

	local userId = tonumber(object:GetAttribute((_S[916])))
	local openError

	if userId then
		openError = math.max(difference, userId)
	else
		openError = difference
	end

	local lines = features.Visuals.AbilityData[callbackFunction] or {}
	local bestAction = features.Visuals.AbilityIcons[callbackFunction] or lines.iconId

	if bestAction == (_S[692]) then
		bestAction = nil
	end

	local radians = AluminousBBState.AbilityUses[line]
	local step = math.max(tonumber(line:GetAttribute((_S[917]))) or 0, tonumber(object:GetAttribute((_S[917]))) or 0)
	local mathMax = math.max(tonumber(line:GetAttribute((_S[918]))) or 0, tonumber(object:GetAttribute((_S[918]))) or 0)
	local leftChild = step + mathMax
	local cell = step > 0 and mathMax > 0

	if cell then
		cell = leftChild >= (radians and radians.Started or 0)
	end

	if cell then
		cell = (descendant or workspace:GetServerTimeNow()) >= leftChild
	end

	local active = radians and radians.Ability == (_S[403])

	if active then
		active = radians.Character ~= object or callbackFunction ~= (_S[403]) or not object:GetAttribute((_S[404])) or cell
	end

	if active then
		features.Visuals.ClearFury(radians)
		AluminousBBState.AbilityUses[line] = nil
		radians = nil
	elseif radians and radians.Recoveries and (radians.Character ~= object or radians.Ability ~= callbackFunction) then
		AluminousBBState.AbilityUses[line] = nil
		radians = nil
	end

	if flags.AbilityESPEnabled and callbackFunction == (_S[403]) and object:GetAttribute((_S[404])) and not cell then
		local index51 = descendant or workspace:GetServerTimeNow()

		if not radians then
			local sourceTable = { Ability = callbackFunction, Character = object, Uses = 0, Started = index51 }
			AluminousBBState.AbilityUses[line] = sourceTable
			radians = sourceTable
		end

		if not radians.TimerId and radians.Uses == 0 then
			local endPosition = 3.5 - index51 - radians.Started

			if 0 < endPosition then
				for _, existingPlayer in workspace.Balls:GetChildren() do
					if existingPlayer:GetAttribute((_S[404]) .. line.Name) then
						if features.Visuals.UpdateFuryTimer(existingPlayer.Name, endPosition, 3.5) then
							radians.TimerId = existingPlayer.Name
						end

						break
					end
				end
			end
		end
	end

	local number, query

	if callbackFunction == (_S[919]) then
		number = tonumber(object:GetAttribute((_S[920])))

		if number == nil then
			number = math.min(openError, 1) + 1
		end

		query = (_S[921])
	else
		number = lines.uses

		if callbackFunction == nil then
			number = workspace:GetAttribute((_S[922])) and 999 or openError + 2
		elseif callbackFunction == (_S[377]) then
			number = openError + 2
		end

		if number then
			if radians and radians.Ability == callbackFunction and radians.Recoveries then
				descendant = descendant or workspace:GetServerTimeNow()

				for k = #radians.Recoveries, 1, -1 do
					if radians.Recoveries[k] <= descendant then
						table.remove(radians.Recoveries, k)
					end
				end

				radians.Maximum = number
				radians.Expiration = radians.Recoveries[1]
				number = math.max(number - #radians.Recoveries, 0)
				radians.Uses = number
			end
		else
			number = nil
		end

		query = (_S[923])
	end

	return callbackFunction, openError + 1, bestAction, lines.isPassive or callbackFunction == (_S[919]), number, query, step, mathMax
end

